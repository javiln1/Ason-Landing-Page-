{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/booking", "destination": "/booking.html" },
    { "source": "/confirmation-page", "destination": "/confirmation-page.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
